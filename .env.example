# AI scoring + cover notes. Free Google key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Free keys have a requests-per-minute limit, so calls are spaced out (seconds). Lower it if you're on a paid key.
# GEMINI_MIN_INTERVAL=4

# Or use Claude instead (pip install anthropic):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Adzuna (Australian jobs, aggregates many boards). Free keys: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=au

# Jooble (aggregator, optional). Request a key: https://jooble.org/api/about
JOOBLE_API_KEY=
# JOOBLE_HOST=au.jooble.org

# Student visa hours (--part-time mode). Not legal advice: check your own visa conditions.
VISA_FORTNIGHT_CAP=48
# Paid hours per fortnight your other jobs already use
COMMITTED_FORTNIGHT_HOURS=0
